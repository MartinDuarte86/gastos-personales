PORT=3010
JWT_SECRET=replace_with_a_secure_secret_at_least_32_chars
NODE_ENV=development
CRON_SECRET=replace_with_a_secure_random_token
DB_DRIVER=sqlite
AUTO_DB_BOOTSTRAP=false
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require
